# ============================================================================
# ⚠️ 값에 특수문자가 있으면 반드시 따옴표로 감싸세요
#
#   dotenv 는 따옴표 없는 값에서 '#' 을 주석 시작으로 해석해 뒤를 잘라냅니다.
#   비밀번호가 '#' 로 끝나면 마지막 글자가 사라져 인증이 실패합니다.
#
#     POSTGRES_PASSWORD=abcd12!#     -> 실제로는 'abcd12!' 로 읽힘  (❌)
#     POSTGRES_PASSWORD='abcd12!#'   -> 'abcd12!#' 그대로 읽힘      (✅)
#
#   '#', 공백, '=' 등이 포함된 값은 예외 없이 작은따옴표로 감싸주세요.
#   (참고: 아래 SENTRY_CLIENT_SECRET 처럼 ' # 설명' 형태의 뒤쪽 주석은 의도된 것입니다)
#
#   같은 규칙이 CI 의 .env 생성 스텝(.github/workflows/api-ci.yaml)에도
#   적용됩니다. secrets 값에 '#' 이 있으면 그쪽도 따옴표가 필요합니다.
# ============================================================================

PORT=8080
ALLOWED_ORIGINS=http://localhost,http://localhost:3000
NODE_ENV=development

# 토큰 단방향 암호화 전용 핵심 키
AES_KEY_0=
AES_KEY_1=
AES_KEY_2=
AES_KEY_3=
AES_KEY_4=
AES_KEY_5=
AES_KEY_6=
AES_KEY_7=
AES_KEY_8=
AES_KEY_9=

# Database
# POSTGRES_PASSWORD 는 특수문자 여부와 무관하게 항상 따옴표로 감싸는 것을 권장합니다 (상단 주의사항 참고)
DATABASE_NAME=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Cache (redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=vd2:
CACHE_DEFAULT_TTL=300

# Slack Notification
SLACK_WEBHOOK_URL=

# Sentry Hook
SENTRY_CLIENT_SECRET=
SENTRY_DSN=